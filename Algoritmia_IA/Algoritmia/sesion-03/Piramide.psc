Algoritmo Piramide
	Definir  fila, n, j Como Entero
	Escribir "Altura de la piramide: "
	Leer n
	fila <- 1
	Para i <- 1 Hasta n Hacer
		Para j <- 1 Hasta n - fila Hacer
			Escribir Sin Saltar " "
			
		FinPara
		
		Para j <- 1 Hasta n + 2 Hacer
			
			Escribir Sin Saltar "*"
			
			
		FinPara
		
		Escribir ""
		
	FinPara
	
FinAlgoritmo
